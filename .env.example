# Optional AI drafting. Leave these values empty to use deterministic local fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=2000

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=2000

# Optional provider preference when both keys are configured: openai or claude
AI_PROVIDER=

# Enable the independently fictional, temporary local demo experience.
PRIORENA_DEMO_MODE=1
